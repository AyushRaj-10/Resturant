# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=restaurant_oms

# Application Environment
APP_ENV=development

# LLM Configuration (Optional: "none", "groq")
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=1

# Multi-Agent Configuration
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_HISTORY_TURNS=6

# Guardrail & Policy Settings (Step 11)
AGENT_WRITES_ENABLED=true
AGENT_DESTRUCTIVE_ENABLED=true
AGENT_CONFIRM_TTL_SECONDS=120
AGENT_MAX_DESTRUCTIVE_PER_REQUEST=1
AGENT_MAX_WRITES_PER_REQUEST=3
AGENT_MAX_TOOL_CALLS_PER_MINUTE_PER_SESSION=20
AGENT_MAX_DISCOUNT_PERCENT=20
AGENT_MAX_ORDER_TOTAL=20000
