# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=restaurant_oms

# Application Environment
APP_ENV=development

# LLM Configuration (Optional: "none", "groq")
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=1

# Multi-Agent Configuration
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_HISTORY_TURNS=6
